menu_settings() {
    while true; do
        mapfile -t schemes < <(find "$PALETTES_DIR" -maxdepth 1 -name "*.json" ! -name "registry.json" -printf '%f\n' | sort)

        local out ret key
        out=$(printf "%s\n" "${schemes[@]}" | fzf --multi --expect=ctrl-d,ctrl-r,ctrl-g \
            --prompt="󰏘  Edit Local Palette ❯ " \
            --header="[ENTER]: Edit | [CTRL-R]: Rename | [CTRL-D]: Delete | [CTRL-G]: Migrate to format 2 (TAB: multi-select) | [ESC]: Back" \
            --bind="ctrl-a:select-all" \
            --preview "'$PREVIEW_SCRIPT' '$PALETTES_DIR/{}'" \
            --preview-window=right:50%:border-left)
        ret=$?

        # ESC o sin seleccion: volver al menu principal
        [[ $ret -eq 130 || $ret -gt 1 ]] && return 0
        [[ -z "$out" ]] && return 0

        key=$(head -n 1 <<< "$out")
        mapfile -t sel < <(tail -n +2 <<< "$out" | grep -v '^$')
        [[ ${#sel[@]} -eq 0 ]] && continue

        if [[ "$key" == "ctrl-r" ]]; then
            if [[ ${#sel[@]} -ne 1 ]]; then
                echo -e "${C_CYAN}[i] Rename: seleccioná una sola palette (TAB para una).${C_RESET}"
                sleep 0.8
                continue
            fi
            local old="${sel[0]}" new_name
            local base="${old%.json}"
            new_name=$(prompt_palette_name "$base")
            [[ -z "$new_name" ]] && continue
            if [[ "$new_name" == "$base" ]]; then
                continue
            fi
            if [[ -f "$PALETTES_DIR/$new_name.json" ]]; then
                local over
                over=$(printf "󰄬  Sobrescribir '%s'\n󰅚  Cancelar" "$new_name" | fzf \
                    --prompt="󰏘  '$new_name.json' ya existe ❯ " \
                    --header="[ENTER]: elegir | [ESC]: cancelar")
                [[ -z "$over" || "$over" == *"Cancelar"* ]] && continue
            fi
            mv -f "$PALETTES_DIR/$old" "$PALETTES_DIR/$new_name.json"
            echo -e "${C_GREEN}[OK] Renamed: $old → $new_name.json${C_RESET}"
            sleep 0.8
            continue
        fi

        # NOTA: ctrl-m NO se puede usar con --expect (ctrl-m == Enter en ASCII)
        if [[ "$key" == "ctrl-g" ]]; then
            local m=0 skipped=0 f
            for f in "${sel[@]}"; do
                local res
                res=$(python3 -c '
import json, sys
path = sys.argv[1]
FMT1 = {"mPrimary":"primary","mOnPrimary":"on_primary","mSecondary":"secondary",
        "mOnSecondary":"on_secondary","mTertiary":"tertiary","mOnTertiary":"on_tertiary",
        "mError":"error","mOnError":"on_error","mSurface":"surface","mOnSurface":"on_surface",
        "mSurfaceVariant":"surface_container","mOnSurfaceVariant":"on_surface_variant",
        "mOutline":"outline_variant","mShadow":"shadow","mHover":"hover","mOnHover":"on_hover",
        "selectionFg":"selection_fg","selectionBg":"selection_bg","cursorText":"cursor_text"}
data = json.load(open(path))
if data.get("version") == 2:
    print("already"); sys.exit(0)
for mode in ("dark", "light"):
    if mode not in data: continue
    data[mode] = {FMT1.get(k, k): v for k, v in data[mode].items()}
    term = data[mode].get("terminal")
    if isinstance(term, dict):
        data[mode]["terminal"] = {FMT1.get(k, k): v for k, v in term.items()}
data.pop("version", None)
with open(path, "w") as fh:
    json.dump({"version": 2, **data}, fh, indent=2)
    fh.write("\n")
print("migrated")' "$PALETTES_DIR/$f" 2>&1)
                if [[ "$res" == "migrated" ]]; then
                    echo -e "${C_GREEN}  󰄬 $f → formato 2${C_RESET}"
                    m=$((m + 1))
                elif [[ "$res" == "already" ]]; then
                    echo -e "${C_CYAN}  󰅚 $f (ya es formato 2)${C_RESET}"
                    skipped=$((skipped + 1))
                else
                    echo -e "${C_RED}  󰖷 $f: $res${C_RESET}"
                fi
            done
            echo -e "${C_GREEN}[OK] $m migradas, $skipped ya estaban en formato 2.${C_RESET}"
            noctalia msg config-reload >/dev/null 2>&1
            sleep 1.2
            continue
        fi

        if [[ "$key" == "ctrl-d" ]]; then
            local n=${#sel[@]} answer
            echo ""
            for f in "${sel[@]}"; do
                echo -e "  ${C_RED}󰖷 $f${C_RESET}"
            done
            answer=$(printf "󰄬  Eliminar\n󰅚  Cancelar" | fzf \
                --prompt="󰏘  Eliminar $n palette(s)? ❯ " \
                --header="[ENTER]: confirmar | [ESC]: cancelar")
            if [[ "$answer" == *"Eliminar"* ]]; then
                local d=0
                for f in "${sel[@]}"; do
                    if [[ -f "$PALETTES_DIR/$f" ]]; then
                        rm -f "$PALETTES_DIR/$f"
                        d=$((d + 1))
                    fi
                done
                echo -e "${C_GREEN}[OK] $d palette(s) eliminadas.${C_RESET}"
            else
                echo -e "${C_CYAN}[i] Cancelado.${C_RESET}"
            fi
            sleep 0.8
            continue
        fi

        # ENTER: editar (una o varias seleccionadas)
        for f in "${sel[@]}"; do
            ${EDITOR:-nano} "$PALETTES_DIR/$f"
            echo -e "${C_GREEN}[OK] Palette updated: $f${C_RESET}"
        done
        sleep 0.6
    done
}

abs_path() { realpath -m "$1" 2>/dev/null || printf '%s' "$1"; }

compute_settings_stamp() {
    printf '%s' "${ADJUST_SPEC}#${VARIANT}" | md5sum | cut -d' ' -f1
}

prune_stamps() {
    local f line dest
    for f in "$STAMPS_DIR"/*; do
        [[ -f "$f" ]] || continue
        line=$(< "$f")
        dest="${line#* }"
        [[ -n "$dest" && ! -f "$dest" ]] && rm -f "$f"
    done
}

sanitize_name() {
    local name="$1"
    name=$(printf '%s' "$name" | sed -E 's/[^a-zA-Z0-9 _-]+/-/g; s/ +/-/g; s/^[-]+|[-]+$//g; s/[-]+/-/g')
    printf '%s' "${name,,}"
}

prompt_palette_name() {
    local default="$1" out query selected choice
    out=$(printf "%s" "$default" | fzf --prompt="󰏘  Nombre del palette ❯ " \
        --header="Default: $default  |  Escribí o editá el nombre + [ENTER]  |  [ESC]: atrás" \
        --print-query)
    ret=$?
    # rc 0 o 1: ENTER acepta el query (1 = sin match, fzf >= 0.61)
    [[ $ret -ne 0 && $ret -ne 1 ]] && return 1
    [[ -z "$out" ]] && return 1
    query=$(head -n 1 <<< "$out")
    selected=$(tail -n 1 <<< "$out")
    choice="$selected"
    [[ -n "$query" && "$query" != "$selected" ]] && choice="$query"
    # conservar mayusculas/espacios (estilo "Cream Autumn"), solo sacar chars invalidos
    choice=$(printf '%s' "$choice" | sed -E 's#[\\/:*?"<>|]##g; s/^ +| +$//g')
    [[ -z "$choice" ]] && return 1
    printf '%s' "$choice"
}

process_palette() {
    local src="$1" dest="$2"
    local dest_abs key stamp_file stamp tmp tmp2 err_file
    dest_abs=$(abs_path "$dest")
    key=$(printf '%s' "$dest_abs" | md5sum | cut -d' ' -f1)
    stamp_file="$STAMPS_DIR/$key"
    stamp=$(compute_settings_stamp)
    mkdir -p "$STAMPS_DIR"

    if [[ -f "$dest" && ! "$src" -nt "$dest" && -f "$stamp_file" && "$(< "$stamp_file")" == "$stamp $dest_abs" ]]; then
        return 1
    fi

    mkdir -p "$(dirname "$dest")"

    theme_0=$(mktemp); theme_d=$(mktemp); theme_l=$(mktemp)
    tmp=$(mktemp); tmp2=$(mktemp); err_file=$(mktemp)

    # Genera un tema recol; si recol paniquea con imagenes de muy pocos colores
    # unicos (assert en palettegen.rs), reintenta con copia JPEG y luego con
    # ruido agregado. NUNCA pasar -a con spec vacio (panica en cli.rs).
    run_recol() {
        local rsrc="$1" rspec="$2" rout="$3" rerr="$4"
        local rlnk
        # symlink unico: evita la colision de /tmp/<stem>_<N>.ppm entre
        # corridas concurrentes de recol sobre el mismo path
        rlnk=$(mktemp -u --suffix=".${rsrc##*.}")
        ln -s -- "$rsrc" "$rlnk"
        local -a rargs=(-m "$rlnk" --json)
        [[ -n "$rspec" ]] && rargs+=(-a "$rspec")
        # brace + 2>/dev/null: silencia el "Abortado" de bash cuando recol paniquea
        if { recol "${rargs[@]}" 2>"$rerr" > "$rout"; } 2>/dev/null && [[ -s "$rout" ]]; then
            rm -f "$rlnk"; return 0
        fi
        local rjpg
        rjpg=$(mktemp --suffix=.jpg)
        ffmpeg -y -loglevel error -i "$rsrc" -qscale:v 2 "$rjpg" 2>/dev/null
        local -a fargs=(-m "$rjpg" --json)
        [[ -n "$rspec" ]] && fargs+=(-a "$rspec")
        if { recol "${fargs[@]}" 2>"$rerr" > "$rout"; } 2>/dev/null && [[ -s "$rout" ]]; then
            rm -f "$rlnk" "$rjpg"; return 0
        fi
        ffmpeg -y -loglevel error -i "$rsrc" -vf "noise=alls=6:allf=t" -qscale:v 2 "$rjpg" 2>/dev/null
        { recol "${fargs[@]}" 2>"$rerr" > "$rout"; } 2>/dev/null
        local rrc=$?
        rm -f "$rlnk" "$rjpg"
        (( rrc == 0 )) && [[ -s "$rout" ]]
    }

    ok=1
    run_recol "$src" "$ADJUST_SPEC" "$theme_0" "$err_file" || ok=0

    if (( ok )); then
        # recol preserva la polaridad de la imagen fuente: si bg[0] es claro,
        # el tema generado ES un tema claro y el dark sale del invertido
        # (y viceversa para imagenes oscuras).
        pol=$(python3 -c '
import json, sys
c = json.load(open(sys.argv[1]))["colors"]
h = c["bg"][0].lstrip("#")
r, g, b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)
print("light" if 0.2126*r+0.7152*g+0.0722*b > 128 else "dark")' "$theme_0")

        conv_args=()
        if [[ "$VARIANT" == "Dark" ]]; then
            if [[ "$pol" == "light" ]]; then
                dark_spec="invert=50,brightness=5"
                [[ -n "$ADJUST_SPEC" ]] && dark_spec="$dark_spec,$ADJUST_SPEC"
                run_recol "$src" "$dark_spec" "$theme_d" "$err_file" || ok=0
            else
                theme_d="$theme_0"
            fi
            conv_args=("$theme_d" "")
        else
            if [[ "$pol" == "dark" ]]; then
                theme_d="$theme_0"
                light_spec="invert=50"
                [[ -n "$ADJUST_SPEC" ]] && light_spec="$light_spec,$ADJUST_SPEC"
                run_recol "$src" "$light_spec" "$theme_l" "$err_file" || ok=0
            else
                theme_l="$theme_0"
                dark_spec="invert=50,brightness=5"
                [[ -n "$ADJUST_SPEC" ]] && dark_spec="$dark_spec,$ADJUST_SPEC"
                run_recol "$src" "$dark_spec" "$theme_d" "$err_file" || ok=0
            fi
            conv_args=("$theme_d" "$theme_l")
        fi
    fi

    if (( ok )) && python3 "$CONVERT_SCRIPT" "${conv_args[@]}" > "$tmp" 2>>"$err_file" && [[ -s "$tmp" ]]; then
        case "$VARIANT" in
            Dark)  jq '.light = .dark' "$tmp" > "$tmp2" && mv "$tmp2" "$dest" ;;
            Light) jq '.dark = .light' "$tmp" > "$tmp2" && mv "$tmp2" "$dest" ;;
            *)     mv "$tmp" "$dest" ;;
        esac
    else
        ok=0
    fi
    rm -f "$theme_0" "$theme_d" "$theme_l"

    if (( ok )); then
        rm -f "$tmp" "$tmp2" "$err_file"
        printf '%s %s' "$stamp" "$dest_abs" > "$stamp_file"
        return 0
    else
        rm -f "$tmp" "$tmp2" "$theme_d" "$theme_l" "$dest"
        echo -e "${C_RED}[ERROR] recol failed for '$src':${C_RESET}" >&2
        head -n 2 "$err_file" | sed 's/^/  /' >&2
        rm -f "$err_file"
        return 2
    fi
}

process_batch() {
    local mode="$1" source_dir="$2"
    shift 2
    local -a files=("$@")
    ((${#files[@]} == 0)) && return 0

    local status_dir
    status_dir=$(mktemp -d)
    local i=0 running=0 img dest name stem

    for img in "${files[@]}"; do
        stem=$(basename "${img%.*}")
        if [[ "$mode" == "folder" ]]; then
            if [[ -n "$CUSTOM_NAME" ]]; then
                name=$(sanitize_name "$CUSTOM_NAME-$stem")
            else
                name=$(sanitize_name "${source_dir}-${stem}")
            fi
        elif [[ -n "$CUSTOM_NAME" ]]; then
            if [[ ${#files[@]} -eq 1 ]]; then
                name="$CUSTOM_NAME"
            else
                name=$(sanitize_name "$CUSTOM_NAME-$stem")
            fi
        else
            name=$(sanitize_name "$stem")
        fi
        dest="$PALETTES_DIR/$name.json"
        (
            process_palette "$img" "$dest"
            printf '%s' "$?" > "$status_dir/$i"
        ) &
        running=$((running + 1))
        if (( running >= MAX_JOBS )); then
            wait -n
            running=$((running - 1))
        fi
        i=$((i + 1))
    done
    wait

    local s
    for s in "$status_dir"/*; do
        case "$(< "$s")" in
            0) count_ok=$((count_ok + 1));;
            1) count_skip=$((count_skip + 1));;
            *) count_err=$((count_err + 1));;
        esac
    done
    rm -rf "$status_dir"
}

# /*
#  * LIVE PALETTE: hook wallpaper_changed de Noctalia (v5+).
#  * Noctalia setea NOCTALIA_WALLPAPER_PATH al cambiar el wallpaper;
#  * el hook regenera la palette y la re-aplica por IPC si esta activa.
#  */
live_hook_enabled() {
    [[ -f "$HOOK_SCRIPT" ]] && grep -q "wallpaper_changed.*live-palette.sh" "$HOOKS_CONF" 2>/dev/null
}

install_live_hook() {
    mkdir -p "$(dirname "$HOOK_SCRIPT")"

    cat > "$HOOK_SCRIPT" << 'HOOKSCRIPT'
#!/usr/bin/env bash
# Live palette: regenera la palette de Noctalia cuando cambia el wallpaper.
# Llamado por el hook wallpaper_changed (NOCTALIA_WALLPAPER_PATH seteado por Noctalia).
set -u
# PATH completo: el hook corre con un PATH minimo (sin ~/.cargo/bin ni ~/.local/bin)
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/usr/local/bin:/usr/bin:/bin"
img="${NOCTALIA_WALLPAPER_PATH:-}"
[[ -n "$img" && -f "$img" ]] || exit 0

# ajustes + nombre desde la conf del ricer (EXTRA_SPEC/LIVE_PALETTE_NAME van citados)
conf="$HOME/.config/noctalia-ricer.conf"
name="Live"
[[ -r "$conf" ]] && source "$conf"

cache="${XDG_CACHE_HOME:-$HOME/.cache}/noctalia-ricer"
mkdir -p "$cache"

# serializar: un solo run a la vez (cambios rapidos)
exec 9>"$cache/live.lock"
flock -n 9 || exit 0

# spec de ajustes (igual que build_adjust_spec del ricer), ANTES del stamp:
# cambiar un ajuste debe invalidar el cache
parts=()
for kv in "saturation=${SATURATION:-0}" "contrast=${CONTRAST:-0}" "brightness=${BRIGHTNESS:-0}" \
          "temperature=${TEMPERATURE:-0}" "tint=${TINT:-0}" "vibrance=${VIBRANCE:-0}" \
          "hue=${HUE:-0}" "normalize=${NORMALIZE:-0}"; do
    v="${kv##*=}"
    [[ "$v" != 0 ]] && parts+=("$kv")
done
[[ -n "${EXTRA_SPEC:-}" ]] && parts+=("$EXTRA_SPEC")
spec="$(IFS=,; echo "${parts[*]}")"

# skip si es el mismo wallpaper y mismos ajustes (hooks de startup)
cur="$(stat -Lc '%Y:%s' "$img" 2>/dev/null):$name:$spec"
[[ -f "$cache/live-stamp" && "$(cat "$cache/live-stamp" 2>/dev/null)" == "$cur" ]] && exit 0

export NOCTALIA_ADJUST_SPEC="$spec"
if ! "$HOME/.local/bin/wallpaper-to-noctalia" "$img" "$name" >> "$cache/live.log" 2>&1; then
    echo "[$(date '+%F %T')] ERROR regenerando desde $img" >> "$cache/live.log"
    exit 0
fi
printf '%s' "$cur" > "$cache/live-stamp"

# re-aplicar si es la palette activa: config-reload re-lee el JSON del palette
# y re-renderiza los templates al instante (templates-apply NO re-lee el JSON,
# y color-scheme-set con el mismo valor es no-op).
scheme="$(noctalia msg color-scheme-get 2>/dev/null)"
if [[ "$scheme" == "custom $name" ]]; then
    noctalia msg config-reload >/dev/null 2>&1
fi
HOOKSCRIPT
    chmod +x "$HOOK_SCRIPT"

    # registrar en config.toml (idempotente: reemplaza la linea previa)
    local cmd="\"$HOOK_SCRIPT\""
    if grep -q '^\[hooks\]' "$HOOKS_CONF" 2>/dev/null; then
        sed -i '/^wallpaper_changed[[:space:]]*=/d' "$HOOKS_CONF"
        sed -i "/^\[hooks\]/a wallpaper_changed = $cmd" "$HOOKS_CONF"
    else
        printf '\n[hooks]\nwallpaper_changed = %s\n' "$cmd" >> "$HOOKS_CONF"
    fi

    noctalia msg config-reload >/dev/null 2>&1
}

uninstall_live_hook() {
    if grep -q '^\[hooks\]' "$HOOKS_CONF" 2>/dev/null; then
        sed -i '/^wallpaper_changed[[:space:]]*=/d' "$HOOKS_CONF"
        # dejar la seccion solo si quedan otros hooks
        if [[ "$(sed -n '/^\[hooks\]/,/^\[/p' "$HOOKS_CONF" | grep -c '=')" -le 1 ]]; then
            sed -i '/^\[hooks\]/d' "$HOOKS_CONF"
        fi
        noctalia msg config-reload >/dev/null 2>&1
    fi
}

# genera la palette live desde el wallpaper actual y devuelve el nombre
live_regenerate() {
    local img
    img=$(noctalia msg wallpaper-get 2>/dev/null | head -n 1)
    [[ -n "$img" && -f "$img" ]] || { echo -e "${C_RED}[!] No active wallpaper found.${C_RESET}"; return 1; }
    NOCTALIA_WALLPAPER_PATH="$img" "$HOOK_SCRIPT"
    echo -e "${C_GREEN}[OK] '$LIVE_PALETTE_NAME.json' generated from: $(basename "$img")${C_RESET}"
}

menu_live_palette() {
    while true; do
        local status="󰅚  disabled"
        live_hook_enabled && status="󰄬  enabled"
        local scheme
        scheme=$(noctalia msg color-scheme-get 2>/dev/null)

        local choice
        choice=$(printf "󰗑  Toggle: %s\n󰏘  Palette name            : <  $LIVE_PALETTE_NAME  >\n󰘮  Tune settings (preview)\n󰜉  Regenerate & apply now\n󰋚  Save copy (freeze current)\n󰗼  Back" "$status" | \
            fzf --prompt="󰥔  LIVE PALETTE (auto on wallpaper change) ❯ " \
                --header="Active scheme: ${scheme:-(noctalia not running)} | [ESC]: Back")
        [[ -z "$choice" ]] && return 0

        case "$choice" in
            *"Toggle"*)
                if live_hook_enabled; then
                    uninstall_live_hook
                    echo -e "${C_CYAN}[i] Live palette hook disabled.${C_RESET}"
                else
                    install_live_hook
                    echo -e "${C_GREEN}[OK] Hook installed ($HOOKS_CONF).${C_RESET}"
                    echo -e "${C_CYAN}[i] Regenerating from current wallpaper...${C_RESET}"
                    live_regenerate
                    local over
                    over=$(printf "󰄬  Yes\n󰅚  No" | fzf \
                        --prompt="󰥔  Activate '$LIVE_PALETTE_NAME' as active palette? ❯ " \
                        --header="[ENTER]: confirm | [ESC]: no")
                    if [[ "$over" == *"Yes"* ]]; then
                        noctalia msg color-scheme-set custom "$LIVE_PALETTE_NAME" >/dev/null 2>&1 \
                            && echo -e "${C_GREEN}[OK] Active palette → $LIVE_PALETTE_NAME${C_RESET}"
                    fi
                fi
                sleep 1
                ;;
            *"Palette name"*)
                local val
                val=$(prompt_palette_name "$LIVE_PALETTE_NAME")
                if [[ -n "$val" && "$val" != "$LIVE_PALETTE_NAME" ]]; then
                    # si estaba activa con el nombre viejo, migrar
                    local was_active=false
                    [[ "$(noctalia msg color-scheme-get 2>/dev/null)" == "custom $LIVE_PALETTE_NAME" ]] && was_active=true
                    if [[ -f "$PALETTES_DIR/$LIVE_PALETTE_NAME.json" && ! -f "$PALETTES_DIR/$val.json" ]]; then
                        mv "$PALETTES_DIR/$LIVE_PALETTE_NAME.json" "$PALETTES_DIR/$val.json"
                    fi
                    if live_hook_enabled; then
                        install_live_hook   # re-escribe script + config.toml
                        noctalia msg config-reload >/dev/null 2>&1
                    fi
                    LIVE_PALETTE_NAME="$val"
                    save_config
                    $was_active && noctalia msg color-scheme-set custom "$val" >/dev/null 2>&1
                    echo -e "${C_GREEN}[OK] Live palette name → $val${C_RESET}"
                fi
                sleep 0.6
                ;;
            *"Tune settings"*)
                local img
                img=$(noctalia msg wallpaper-get 2>/dev/null | head -n 1)
                [[ -n "$img" && -f "$img" ]] || img=$(get_sample_image)
                if interactive_tune_settings "$img" "Live palette"; then
                    live_hook_enabled && live_regenerate
                fi
                ;;
            *"Regenerate"*)
                if live_regenerate; then
                    # ya activa: config-reload re-lee el JSON al instante; sino: activarla
                    if [[ "$(noctalia msg color-scheme-get 2>/dev/null)" == "custom $LIVE_PALETTE_NAME" ]]; then
                        noctalia msg config-reload >/dev/null 2>&1
                    else
                        noctalia msg color-scheme-set custom "$LIVE_PALETTE_NAME" >/dev/null 2>&1
                    fi
                    echo -e "${C_GREEN}[OK] Applied.${C_RESET}"
                fi
                sleep 0.8
                ;;
            *"Save copy"*)
                if [[ ! -f "$PALETTES_DIR/$LIVE_PALETTE_NAME.json" ]]; then
                    echo -e "${C_RED}[!] '$LIVE_PALETTE_NAME.json' no existe. Corré 'Regenerate & apply now' primero.${C_RESET}"
                    sleep 1.2
                    continue
                fi
                # default del nombre: wallpaper actual
                local save_img save_base newname
                save_img=$(noctalia msg wallpaper-get 2>/dev/null | head -n 1)
                save_base=$(basename "${save_img%.*}" 2>/dev/null)
                [[ -z "$save_base" ]] && save_base="$LIVE_PALETTE_NAME"
                newname=$(prompt_palette_name "$save_base") || continue
                [[ -z "$newname" ]] && continue
                if [[ -f "$PALETTES_DIR/$newname.json" ]]; then
                    local over
                    over=$(printf "󰄬  Yes\n󰅚  No" | fzf \
                        --prompt="󰏘  '$newname.json' ya existe. ¿Sobrescribir? ❯ " \
                        --header="[ENTER]: sí | [ESC]: no")
                    [[ "$over" != *"Yes"* ]] && continue
                    rm -f "$PALETTES_DIR/$newname.json"
                fi
                cp "$PALETTES_DIR/$LIVE_PALETTE_NAME.json" "$PALETTES_DIR/$newname.json"
                echo -e "${C_GREEN}[OK] Saved: '$newname.json' (congelada — la live sigue actualizándose).${C_RESET}"
                # ofrecer activarla
                local act
                act=$(printf "󰄬  Yes\n󰅚  No" | fzf \
                    --prompt="󰏘  Activate '$newname' as active palette? ❯ " \
                    --header="[ENTER]: sí | [ESC]: no")
                if [[ "$act" == *"Yes"* ]]; then
                    noctalia msg color-scheme-set custom "$newname" >/dev/null 2>&1 \
                        && echo -e "${C_GREEN}[OK] Active palette → $newname${C_RESET}"
                fi
                sleep 0.8
                ;;
        esac
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then

check_deps
load_config

# Si el cwd no tiene imágenes, trabajar directo en la carpeta de wallpapers
if ! find . -maxdepth 2 -type f \( "${IMG_PATTERN[@]}" \) 2>/dev/null | head -n 1 | grep -q .; then
    if [[ -d "$WALLPAPER_DIR" ]]; then
        echo -e "${C_CYAN}[*] No images in cwd. Working from '$WALLPAPER_DIR'...${C_RESET}"
        cd "$WALLPAPER_DIR" || exit 1
    fi
fi

mkdir -p "$STAMPS_DIR"
prune_stamps

STATE="MAIN"

while true; do
    case "$STATE" in
        "MAIN")
            MAIN_CHOICE=$(printf "󰉋  1. Process full folder\n󰋹  2. Individual selection (fzf)\n󰏘  3. Edit local palettes\n󰘮  4. Processing Settings (Saturation/Contrast/Brightness/Temperature)\n󰥔  5. Live palette (auto-update on wallpaper change)\n󰍃  q. Exit" | \
                fzf --prompt="[ 󰏘 NOCTALIA RICER ] ❯ " \
                    --header="[q / ESC]: Exit" \
                    --bind="q:abort")

            if [[ -z "$MAIN_CHOICE" ]]; then
                echo -e "${C_YELLOW}Exiting Noctalia Ricer...${C_RESET}"
                exit 0
            fi

            case "$MAIN_CHOICE" in
                *"1."*) SOURCE_MODE="Full folder"; STATE="SOURCE" ;;
                *"2."*) SOURCE_MODE="Individual"; STATE="SOURCE" ;;
                *"3."*) menu_settings; STATE="MAIN" ;;
                *"4."*) menu_processing_settings; STATE="MAIN" ;;
                *"5."*) menu_live_palette ;;
                *"q."*) echo -e "${C_YELLOW}Exiting...${C_RESET}"; exit 0 ;;
            esac
            ;;

        "SOURCE")
            if [[ "$SOURCE_MODE" == "Full folder" ]]; then
                mapfile -t folders < <(find . -maxdepth 1 -type d ! -name "." ! -name ".*" | sed 's|^\./||' | sort)
                SOURCE_DIR=$(printf "%s\n" "${folders[@]}" | fzf --prompt="󰉋  Source folder ❯ " --header="[ESC]: Back")

                [[ -z "$SOURCE_DIR" ]] && { STATE="MAIN"; continue; }

                mapfile -t folder_images < <(find "$SOURCE_DIR" -type f \( "${IMG_PATTERN[@]}" \) | sed 's|^\./||' | sort)
                if [[ ${#folder_images[@]} -eq 0 ]]; then
                    echo -e "${C_RED}[!] No images found in '$SOURCE_DIR'.${C_RESET}"
                    sleep 1.5
                    STATE="SOURCE"
                    continue
                fi

                SAMPLE_WALLPAPER=$(printf "%s\n" "${folder_images[@]}" | fzf \
                    --prompt="󰋩  Select Sample Image to Preview & Tune ❯ " \
                    --header="[ENTER]: Pick reference image for tuning | [ESC]: Back" \
                    --preview 'chafa -f sixel -s "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}" {} 2>/dev/null || chafa {}' \
                    --preview-window=right:55%:border-left)

                [[ -z "$SAMPLE_WALLPAPER" ]] && { STATE="SOURCE"; continue; }
            else
                mapfile -t SELECTED_FILES < <(find . -type f \( "${IMG_PATTERN[@]}" \) | sed 's|^\./||' | sort | \
                    fzf --multi \
                        --prompt="󰋹  Select images ❯ " \
                        --header="[TAB]: Toggle | [CTRL-A]: Select All | [ESC]: Back" \
                        --bind="ctrl-a:select-all,ctrl-d:deselect-all,ctrl-t:toggle-all" \
                        --preview 'chafa -f sixel -s "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}" {} 2>/dev/null || chafa {}' \
                        --preview-window=right:55%:border-left)

                [[ ${#SELECTED_FILES[@]} -eq 0 ]] && { STATE="MAIN"; continue; }
                SOURCE_DIR="Individual"
                CUSTOM_NAME=""

                if [[ ${#SELECTED_FILES[@]} -gt 1 ]]; then
                    SAMPLE_WALLPAPER=$(printf "%s\n" "${SELECTED_FILES[@]}" | fzf \
                        --prompt="󰋩  Select Sample Image to Preview & Tune ❯ " \
                        --header="[ENTER]: Pick reference image for tuning | [ESC]: Back" \
                        --preview 'chafa -f sixel -s "${FZF_PREVIEW_COLUMNS}x${FZF_PREVIEW_LINES}" {} 2>/dev/null || chafa {}' \
                        --preview-window=right:55%:border-left)
                    [[ -z "$SAMPLE_WALLPAPER" ]] && { STATE="SOURCE"; continue; }
                else
                    SAMPLE_WALLPAPER="${SELECTED_FILES[0]}"
                fi
            fi
            STATE="TUNE_SETTINGS"
            ;;

        "TUNE_SETTINGS")
            context_name="Folder: $SOURCE_DIR"
            [[ "$SOURCE_MODE" == "Individual" ]] && context_name=$(basename "$SAMPLE_WALLPAPER")

            if interactive_tune_settings "$SAMPLE_WALLPAPER" "$context_name"; then
                STATE="VARIANT"
            else
                STATE="SOURCE"
            fi
            ;;

        "VARIANT")
            VAR_CHOICE=$(printf "󱎕  Both\n󰖔  Dark\n󰖨  Light" | fzf --prompt="󰏘  Variant to generate ❯ " --header="Both = full palette (dark + light) | [ESC]: Back to tuning")
            [[ -z "$VAR_CHOICE" ]] && { STATE="TUNE_SETTINGS"; continue; }
            VARIANT="${VAR_CHOICE##* }"
            save_config
            STATE="PROCESS"
            ;;

        "PROCESS")
            count_ok=0; count_skip=0; count_err=0

            build_adjust_spec

            echo -e "${C_CYAN}    Parallel jobs: $MAX_JOBS (override with MAX_JOBS=N)${C_RESET}"

            if [[ "$SOURCE_MODE" == "Full folder" ]]; then
                mapfile -t batch_files < <(find "$SOURCE_DIR" -type f \( "${IMG_PATTERN[@]}" \))
                echo -e "\n${C_BLUE}[*] Generating palettes for '$SOURCE_DIR'...${C_RESET}"
                process_batch "folder" "$SOURCE_DIR" "${batch_files[@]}"
            else
                echo -e "\n${C_BLUE}[*] Generating palettes for ${#SELECTED_FILES[@]} image(s)...${C_RESET}"
                process_batch "individual" "" "${SELECTED_FILES[@]}"
            fi

            echo -e "\n${C_GREEN}[OK] Process completed successfully.${C_RESET}"
            echo -e "${C_CYAN}    Generated: $count_ok  |  Skipped (Cache): $count_skip  |  Errors: $count_err${C_RESET}"
            echo -e "${C_CYAN}    Palettes dir: $PALETTES_DIR${C_RESET}\n"

            exit 0
            ;;
    esac
done

fi
