#!/usr/bin/env bash

# /*
#  * NOCTALIA RICER (recol edition)
#  * Author: basado en LUTGEN RICER (Ezequiel/Zeke, Mikuri12)
#  *
#  * Mismo flujo que ricer, pero genera palettes de Noctalia
#  * desde wallpapers usando recol (ffmpeg palettegen).
#  * Flow managed via state machine to allow backtracking (ESC).
#  */

C_BLUE="\e[1;34m"; C_GREEN="\e[1;32m"; C_RED="\e[1;31m"; C_YELLOW="\e[1;33m"; C_CYAN="\e[1;36m"; C_RESET="\e[0m"

PALETTES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/palettes"
WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Imágenes/Wallpapers}"

