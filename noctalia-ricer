# Live palette: hook de Noctalia que regenera la palette al cambiar el wallpaper
LIVE_PALETTE_NAME="Live"
HOOKS_CONF="$HOME/.config/noctalia/config.toml"
HOOK_SCRIPT="$HOME/.config/noctalia/hooks/live-palette.sh"

# Ajustes recol (defaults: sin cambios)
SATURATION="0"
CONTRAST="0"
BRIGHTNESS="0"
TEMPERATURE="0"
TINT="0"
VIBRANCE="0"
HUE="0"
NORMALIZE="0"
EXTRA_SPEC=""

VARIANT="Both"
CUSTOM_NAME=""

ADJUST_SPEC=""
SELECTED_FILES=()
SAMPLE_WALLPAPER=""

IMG_PATTERN=(-iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif")

