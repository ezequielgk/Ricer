trap 'rm -f "$PREVIEW_SCRIPT" "$LIVE_PREVIEW_SCRIPT" "$CONVERT_SCRIPT"' EXIT SIGINT SIGTERM

# /*
#  * CONVERT: recol JSON -> palette Noctalia (Material Design 3 + terminal)
#  */
cat << 'EOF' > "$CONVERT_SCRIPT"
#!/usr/bin/env python3
"""Noctalia palette builder.
Usage: conv.py <dark_theme.json> [light_theme.json]

dark:  recol -m IMG --json (o con -a spec)
light: recol -m IMG --json -a "invert=50[,spec]"

Si no se pasa light, la variante light se espeja igual a la dark.
"""
import json, sys

ANSI = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
ACCENT_KEYS = ("red", "orange", "yellow", "green", "cyan", "blue", "magenta", "pink")

def hex_rgb(h):
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)

def rgb_hex(r, g, b):
    return f"#{max(r,0)&255:02x}{max(g,0)&255:02x}{max(b,0)&255:02x}"

def shade(h, factor):
    r, g, b = hex_rgb(h)
    return rgb_hex(int(r * factor), int(g * factor), int(b * factor))

def hue_sat(h):
    r, g, b = (x / 255 for x in hex_rgb(h))
    mx, mn = max(r, g, b), min(r, g, b)
    if mx == mn:
        return -1, 0.0
    d = mx - mn
    s = d / mx
    if mx == r: hd = ((g - b) / d) % 6
    elif mx == g: hd = (b - r) / d + 2
    else: hd = (r - g) / d + 4
    return (hd * 60) % 360, s

def hue_dist(a, b):
    if a < 0 or b < 0:
        return 180
    d = abs(a - b) % 360
    return min(d, 360 - d)

def pick_accents(c):
    """Primary/secundario/terciario: ANSI mas cromaticos con hue distinto.
    Fallback: cursor.bg si la imagen es esencialmente gris."""
    base = c["base"]
    seen, scored = set(), []
    for k in ACCENT_KEYS:
        h = base[k]
        if h not in seen:
            seen.add(h)
            scored.append(h)
    scored.sort(key=lambda h: hue_sat(h)[1], reverse=True)

    primario = c["cursor"]["bg"]
    p_h, p_s = hue_sat(primario)
    if scored and hue_sat(scored[0])[1] > max(p_s, 0.12):
        primario = scored[0]
        p_h, _ = hue_sat(primario)

    pool = [h for h in scored if h != primario]
    sec = next((h for h in pool if hue_dist(hue_sat(h)[0], p_h) > 40), None)
    if sec is None:
        sec = pool[0] if pool else base["cyan"]
    s_h = hue_sat(sec)[0]

    pool2 = [h for h in pool if h != sec]
    ter = next((h for h in pool2 if hue_dist(hue_sat(h)[0], p_h) > 40
                and hue_dist(hue_sat(h)[0], s_h) > 40), None)
    if ter is None:
        ter = pool2[0] if pool2 else sec
    return primario, sec, ter

def lum_hex(h):
    """Luminancia relativa (WCAG) de un hex."""
    def lin(x):
        x /= 255.0
        return x / 12.92 if x <= 0.04045 else ((x + 0.055) / 1.055) ** 2.4
    r, g, b = hex_rgb(h)
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)

def contrast(a, b):
    la, lb = lum_hex(a), lum_hex(b)
    return (max(la, lb) + 0.05) / (min(la, lb) + 0.05)

def ensure_contrast(fg, bg, target=3.0):
    """Ajusta el fondo (acento) hasta que el par on_x/x alcance el ratio.
    Igual que el check de CI (floor 2.0, warn <3.0): apuntamos a >=3.0."""
    if contrast(fg, bg) >= target:
        return bg
    factor = 1.06 if lum_hex(fg) < lum_hex(bg) else 0.94
    for _ in range(60):
        bg = shade(bg, factor)
        if contrast(fg, bg) >= target:
            return bg
    return bg

# Piso de luminancia del fondo dark: evita fondos casi negro en wallpapers
# oscuros (estilo Cafecito/Noir, ~luma de #171717).
MIN_DARK_LUM = 0.0085

def dark_surface(bg):
    """Fondo dark: bg[1] (el tono que usaba el shell, mas claro que bg[0]).
    Si es casi negro se mezcla hacia bg[2] hasta el piso de luminancia.
    mSurface y terminal.background comparten este mismo color."""
    s, hi = bg[1], bg[2]
    l1, l2 = lum_hex(s), lum_hex(hi)
    if l1 >= MIN_DARK_LUM or l2 <= l1:
        return s
    t = min((MIN_DARK_LUM - l1) / (l2 - l1), 0.5)
    r1, g1, b1 = hex_rgb(s)
    r2, g2, b2 = hex_rgb(hi)
    return rgb_hex(int(r1 + (r2 - r1) * t), int(g1 + (g2 - g1) * t),
                   int(b1 + (b2 - b1) * t))

def build_dark(c):
    base, bright = c["base"], c["bright"]
    bg, fg = c["bg"], c["fg"]
    primario, secundario, terciario = pick_accents(c)
    superficie = dark_surface(bg)
    on = bg[0]  # texto sobre acentos (oscuro en dark)
    primario = ensure_contrast(on, primario)
    secundario = ensure_contrast(on, secundario)
    terciario = ensure_contrast(on, terciario)
    error = ensure_contrast(on, base["red"])
    hover = ensure_contrast(fg[0], bg[3])
    return {
        "primary": primario, "on_primary": on,
        "secondary": secundario, "on_secondary": on,
        "tertiary": terciario, "on_tertiary": on,
        "error": error, "on_error": on,
        # surface == terminal.background: para apps de terminal el fondo debe
        # ser identico al del shell (convencion Cafecito/Noir).
        "surface": superficie, "on_surface": fg[0],
        "surface_container": bg[2], "on_surface_variant": fg[0],
        "outline_variant": bg[4], "shadow": shade(bg[0], 0.6),
        "hover": hover, "on_hover": fg[0],
        "terminal": {
            "normal": {k: base[k] for k in ANSI},
            "bright": {k: bright[k] for k in ANSI},
            "foreground": fg[0], "background": superficie,
            "selection_fg": bg[0], "selection_bg": primario,
            "cursor_text": bg[0], "cursor": fg[0],
        },
    }

def build_light(dark_c, light_c):
    # Superficies y fg: del tema invertido de recol (conserva el tinte del wallpaper)
    s0, s1, s2, s4 = (light_c["bg"][0], light_c["bg"][1],
                      light_c["bg"][2], light_c["bg"][4])
    fg0 = light_c["fg"][0]
    # Acentos: del tema dark, oscurecidos (convencion Cafecito ~x0.78-0.90)
    primario, secundario, terciario = pick_accents(dark_c)
    primario, secundario = shade(primario, 0.9), shade(secundario, 0.85)
    terciario, error = shade(terciario, 0.85), shade(dark_c["base"]["red"], 0.82)
    # asegurar on_x legible sobre cada acento (CI: floor 2.0, warn <3.0)
    primario = ensure_contrast(s0, primario)
    secundario = ensure_contrast(s0, secundario)
    terciario = ensure_contrast(s0, terciario)
    error = ensure_contrast(s0, error)
    return {
        "primary": primario, "on_primary": s0,
        "secondary": secundario, "on_secondary": s0,
        "tertiary": terciario, "on_tertiary": s0,
        "error": error, "on_error": s0,
        "surface": s0, "on_surface": fg0,
        "surface_container": s1, "on_surface_variant": fg0,
        "outline_variant": s4, "shadow": shade(s4, 0.7),
        "hover": ensure_contrast(fg0, s2), "on_hover": fg0,
        "terminal": {
            "normal": {k: (s4 if k == "black" else
                           dark_c["bg"][0] if k == "white" else
                           shade(dark_c["base"][k], 0.78)) for k in ANSI},
            "bright": {k: (shade(s4, 0.8) if k == "black" else
                           shade(dark_c["bg"][0], 0.62) if k == "white" else
                           shade(dark_c["bright"][k], 0.79)) for k in ANSI},
            "foreground": fg0, "background": s0,
            "selection_fg": s0, "selection_bg": primario,
            "cursor_text": s0, "cursor": fg0,
        },
    }

def main():
    with open(sys.argv[1]) as f:
        dark_c = json.load(f)["colors"]
    if len(sys.argv) > 2 and sys.argv[2]:
        with open(sys.argv[2]) as f:
            light_c = json.load(f)["colors"]
        light = build_light(dark_c, light_c)
    else:
        light = build_dark(dark_c)
    print(json.dumps({"version": 2, "dark": build_dark(dark_c), "light": light}, indent=2))

if __name__ == "__main__":
    main()
EOF
chmod +x "$CONVERT_SCRIPT"

# /*
#  * PREVIEW: swatches de un palette guardado (para editar palettes)
#  */
cat << 'EOF' > "$PREVIEW_SCRIPT"
#!/usr/bin/env bash
file="$1"

swatch_row() {
    local label="$1"; shift
    printf "  %-11s" "$label"
    local hex shown=0
    for hex in "$@"; do
        hex="${hex//\#/}"
        if [[ ${#hex} -eq 6 ]]; then
            printf "\e[48;2;%d;%d;%dm     \e[0m" \
                $((16#${hex:0:2})) $((16#${hex:2:2})) $((16#${hex:4:2}))
            shown=1
        fi
    done
    (( shown )) || printf "\e[2m  (faltan colores)\e[0m"
    echo ""
}

if [[ ! -f "$file" ]]; then
    echo "  [!] Palette no encontrado."
    exit 0
fi

name=$(basename "$file" .json)
echo -e "\e[1;36m󰏘 Palette: $name\e[0m"
echo ""

if [[ "$(jq -r 'type == "object" and (has("dark") or has("light"))' "$file" 2>/dev/null)" != "true" ]]; then
    echo -e "  \e[1;33m[!] No es una palette de Noctalia (sin variant dark/light).\e[0m"
    exit 0
fi

for variant in dark light; do
    [[ "$(jq -r "has(\"$variant\")" "$file")" != "true" ]] && continue
    echo -e "\e[1;35m $variant\e[0m"
    swatch_row "UI"       $(jq -r ".$variant | .primary // .mPrimary // empty, .secondary // .mSecondary // empty, .tertiary // .mTertiary // empty, .error // .mError // empty" "$file" 2>/dev/null)
    swatch_row "Surface"  $(jq -r ".$variant | .surface // .mSurface // empty, .surface_container // .mSurfaceVariant // empty, .outline_variant // .mOutline // empty, .hover // .mHover // empty" "$file" 2>/dev/null)
    swatch_row "Terminal" $(jq -r ".$variant.terminal?.normal? | [.black, .red, .green, .yellow, .blue, .magenta, .cyan, .white] // [] | .[]?" "$file" 2>/dev/null)
    swatch_row "Bright"   $(jq -r ".$variant.terminal?.bright? | [.black, .red, .green, .yellow, .blue, .magenta, .cyan, .white] // [] | .[]?" "$file" 2>/dev/null)
    echo ""
done
EOF
chmod +x "$PREVIEW_SCRIPT"

# /*
#  * LIVE PREVIEW: imagen + swatches del palette en tuning (con cache por stamp)
#  */
cat << 'EOF' > "$LIVE_PREVIEW_SCRIPT"
#!/usr/bin/env bash
cache_dir="/tmp/noctalia_ricer_preview"
mkdir -p "$cache_dir"

sample_img="$PREV_IMG"
adjust="$PREV_SPEC"
name="$PREV_NAME"
convert_script="$CONVERT_SCRIPT"

stamp="${sample_img}#${adjust}#${name}"
stamp_hash=$(printf '%s' "$stamp" | md5sum | cut -d' ' -f1)
stamp_file="$cache_dir/stamp_${stamp_hash}"
rendered_file="$cache_dir/rendered_${stamp_hash}"
palette_file="$cache_dir/palette_${stamp_hash}.json"
thumb="$cache_dir/thumb_${stamp_hash}.png"

if [[ -f "$stamp_file" && "$(< "$stamp_file")" == "$stamp" && -s "$rendered_file" ]]; then
    cat "$rendered_file"
    exit 0
fi

swatch_row() {
    local label="$1"; shift
    printf "  %-11s" "$label"
    local hex
    for hex in "$@"; do
        hex="${hex//\#/}"
        [[ ${#hex} -eq 6 ]] && printf "\e[48;2;%d;%d;%dm     \e[0m" \
            $((16#${hex:0:2})) $((16#${hex:2:2})) $((16#${hex:4:2}))
    done
    echo ""
}

# recol con fallbacks: imagenes de pocos colores unicos (pixel-art) hacen
# paniquear a recol; reintenta con JPEG y luego con ruido (misma cadena que
# el flujo de procesado). Sin esto el preview muere con traceback de python.
recol_try() {
    local img="$1" spec="$2" out="$3"
    local lnk
    # symlink con nombre unico: recol escribe PPMs en /tmp segun el stem del
    # input; dos corridas concurrentes con el mismo stem colisionan y paniquean
    lnk=$(mktemp -u --suffix=".${img##*.}")
    ln -s -- "$img" "$lnk"
    # brace + 2>/dev/null: silencia el "Abortado" que bash imprime cuando
    # recol paniquea (sino spamea el preview en cada reintento)
    if [[ -n "$spec" ]]; then
        { recol -m "$lnk" -a "$spec" --json > "$out"; } 2>/dev/null
    else
        { recol -m "$lnk" --json > "$out"; } 2>/dev/null
    fi
    rm -f "$lnk"
}
recol_fb() {
    local img="$1" spec="$2" out="$3"
    local fb="$cache_dir/fb_${stamp_hash}.jpg"
    recol_try "$img" "$spec" "$out"
    [[ -s "$out" ]] && return 0
    ffmpeg -y -loglevel error -i "$img" -qscale:v 2 "$fb" 2>/dev/null
    recol_try "$fb" "$spec" "$out"
    [[ -s "$out" ]] && return 0
    # ruido fuerte: en thumbs chicas alls=6 no basta para superar el piso
    # de colores unicos que recol exige
    ffmpeg -y -loglevel error -i "$img" -vf "noise=alls=20:allf=t" -qscale:v 2 "$fb" 2>/dev/null
    recol_try "$fb" "$spec" "$out"
    [[ -s "$out" ]] && return 0
    # ultimo recurso: imagen original a resolucion completa + ruido
    ffmpeg -y -loglevel error -i "$img" -vf "noise=alls=6:allf=t" -qscale:v 2 "$fb" 2>/dev/null
    recol_try "$fb" "$spec" "$out"
}

{
    echo -e "\e[1;36m󰏘 Live Preview\e[0m"
    echo -e "  \e[1;35m Palette:\e[0m $name"
    echo -e "  \e[1;34m Adjust:\e[0m ${adjust:-(none)}"
    echo ""

    if [[ -n "$sample_img" && -f "$sample_img" ]]; then
        base_name=$(basename "$sample_img")

        if [[ ! -f "$thumb" || "$sample_img" -nt "$thumb" ]]; then
            ffmpeg -y -loglevel error -i "$sample_img" -vf "scale=360:-2" "$thumb" 2>/dev/null \
                || cp "$sample_img" "$thumb"
        fi

        if [[ ! -f "$palette_file" || ! -s "$palette_file" ]]; then
            theme_a="$cache_dir/themeA_${stamp_hash}.json"
            theme_b="$cache_dir/themeB_${stamp_hash}.json"
            if [[ -n "$adjust" ]]; then
                recol_fb "$thumb" "$adjust" "$theme_a"
            else
                recol_fb "$thumb" "" "$theme_a"
            fi
            # polaridad: si el tema base es claro, A=light (dark sale del invertido)
            if [[ "$(python3 -c '
import json, sys
c = json.load(open(sys.argv[1]))["colors"]
h = c["bg"][0].lstrip("#")
r, g, b = int(h[0:2],16), int(h[2:4],16), int(h[4:6],16)
print("light" if 0.2126*r+0.7152*g+0.0722*b > 128 else "dark")' "$theme_a" 2>/dev/null)" == "light" ]]; then
                inv_spec="invert=50,brightness=5"
                [[ -n "$adjust" ]] && inv_spec="$inv_spec,$adjust"
                recol_fb "$thumb" "$inv_spec" "$theme_b"
                # solo si ambos temas salieron (evita traceback con archivos vacios)
                [[ -s "$theme_a" && -s "$theme_b" ]] && \
                    python3 "$convert_script" "$theme_b" "$theme_a" > "$palette_file"
            else
                inv_spec="invert=50"
                [[ -n "$adjust" ]] && inv_spec="$inv_spec,$adjust"
                recol_fb "$thumb" "$inv_spec" "$theme_b"
                [[ -s "$theme_a" && -s "$theme_b" ]] && \
                    python3 "$convert_script" "$theme_a" "$theme_b" > "$palette_file"
            fi
        fi

        chafa -f sixel -s "${FZF_PREVIEW_COLUMNS:-50}x14" "$thumb" 2>/dev/null || chafa -s "${FZF_PREVIEW_COLUMNS:-50}x14" "$thumb"
        echo ""

        if [[ -s "$palette_file" ]]; then
            swatch_row "UI dark"  "$(jq -r '.dark.primary // .dark.mPrimary' "$palette_file")" "$(jq -r '.dark.secondary // .dark.mSecondary' "$palette_file")" "$(jq -r '.dark.tertiary // .dark.mTertiary' "$palette_file")" "$(jq -r '.dark.error // .dark.mError' "$palette_file")"
            swatch_row "Surface"  "$(jq -r '.dark.surface // .dark.mSurface' "$palette_file")" "$(jq -r '.dark.surface_container // .dark.mSurfaceVariant' "$palette_file")" "$(jq -r '.dark.outline_variant // .dark.mOutline' "$palette_file")" "$(jq -r '.dark.hover // .dark.mHover' "$palette_file")"
            swatch_row "Terminal" $(jq -r '.dark.terminal | [.normal.black, .normal.red, .normal.green, .normal.yellow, .normal.blue, .normal.magenta, .normal.cyan, .normal.white] | .[]' "$palette_file")
            swatch_row "Bright"   $(jq -r '.dark.terminal | [.bright.black, .bright.red, .bright.green, .bright.yellow, .bright.blue, .bright.magenta, .bright.cyan, .bright.white] | .[]' "$palette_file")
            swatch_row "Light"    "$(jq -r '.light.primary // .light.mPrimary' "$palette_file")" "$(jq -r '.light.surface // .light.mSurface' "$palette_file")" "$(jq -r '.light.outline_variant // .light.mOutline' "$palette_file")"
            echo ""
            swatch_row "Term dark" "$(jq -r .dark.terminal.background "$palette_file")" "$(jq -r .dark.terminal.foreground "$palette_file")" "$(jq -r '.dark.terminal.selection_bg // .dark.terminal.selectionBg' "$palette_file")"
        else
            chafa -s "${FZF_PREVIEW_COLUMNS:-50}x${FZF_PREVIEW_LINES:-24}" "$thumb" 2>/dev/null
            echo -e "\n  \e[1;31m[Notice: Could not generate palette]\e[0m"
        fi
    else
        echo "  [!] No sample image found for live preview."
    fi
} > "$rendered_file"

echo "$stamp" > "$stamp_file"
cat "$rendered_file"
EOF
chmod +x "$LIVE_PREVIEW_SCRIPT"

check_deps() {
    for cmd in recol ffmpeg fzf chafa jq python3; do
        if ! command -v "$cmd" &>/dev/null; then
            echo -e "${C_RED}[ERROR] Missing dependency: '$cmd'.${C_RESET}"
            exit 1
        fi
    done
}

load_config() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        save_config
        return
    fi

    local key val
    while IFS='=' read -r key val; do
        key="${key// /}"
        [[ -z "$key" || "$key" == \#* ]] && continue
        val="${val%$'\r'}"

        case "$key" in
            SATURATION)   [[ "$val" =~ ^-?[0-9]+$ ]] && SATURATION="$val" ;;
            CONTRAST)     [[ "$val" =~ ^-?[0-9]+$ ]] && CONTRAST="$val" ;;
            BRIGHTNESS)   [[ "$val" =~ ^-?[0-9]+$ ]] && BRIGHTNESS="$val" ;;
            TEMPERATURE)  [[ "$val" =~ ^-?[0-9]+$ ]] && TEMPERATURE="$val" ;;
            TINT)         [[ "$val" =~ ^-?[0-9]+$ ]] && TINT="$val" ;;
            VIBRANCE)     [[ "$val" =~ ^-?[0-9]+$ ]] && VIBRANCE="$val" ;;
            HUE)          [[ "$val" =~ ^-?[0-9]+$ ]] && HUE="$val" ;;
            NORMALIZE)    [[ "$val" =~ ^-?[0-9]+$ ]] && NORMALIZE="$val" ;;
            EXTRA_SPEC)   EXTRA_SPEC="$val" ;;
            VARIANT)      [[ "$val" =~ ^(Dark|Light|Both)$ ]] && VARIANT="$val" ;;
            LIVE_PALETTE_NAME) LIVE_PALETTE_NAME="$val" ;;
        esac
    done < "$CONFIG_FILE"
    return 0
}

save_config() {
    cat > "$CONFIG_FILE" << EOF
SATURATION=$SATURATION
CONTRAST=$CONTRAST
BRIGHTNESS=$BRIGHTNESS
TEMPERATURE=$TEMPERATURE
TINT=$TINT
VIBRANCE=$VIBRANCE
HUE=$HUE
NORMALIZE=$NORMALIZE
EXTRA_SPEC="$EXTRA_SPEC"
VARIANT=$VARIANT
LIVE_PALETTE_NAME="$LIVE_PALETTE_NAME"
EOF
}

build_adjust_spec() {
    ADJUST_SPEC=""
    local -a parts=()
    (( 10#$SATURATION  != 0 )) && parts+=("saturation=$SATURATION")
    (( 10#$CONTRAST    != 0 )) && parts+=("contrast=$CONTRAST")
    (( 10#$BRIGHTNESS  != 0 )) && parts+=("brightness=$BRIGHTNESS")
    (( 10#$TEMPERATURE != 0 )) && parts+=("temperature=$TEMPERATURE")
    (( 10#$TINT        != 0 )) && parts+=("tint=$TINT")
    (( 10#$VIBRANCE    != 0 )) && parts+=("vibrance=$VIBRANCE")
    (( 10#$HUE         != 0 )) && parts+=("hue=$HUE")
    (( 10#$NORMALIZE   != 0 )) && parts+=("normalize=$NORMALIZE")
    [[ -n "$EXTRA_SPEC" ]] && parts+=("$EXTRA_SPEC")
    ADJUST_SPEC=$(IFS=,; echo "${parts[*]}")
}

reset_settings() {
    SATURATION="0"; CONTRAST="0"; BRIGHTNESS="0"; TEMPERATURE="0"
    TINT="0"; VIBRANCE="0"; HUE="0"; NORMALIZE="0"; EXTRA_SPEC=""
    save_config
}

get_sample_image() {
    if [[ -n "$SAMPLE_WALLPAPER" && -f "$SAMPLE_WALLPAPER" ]]; then
        echo "$SAMPLE_WALLPAPER"
        return 0
    fi
    if [[ ${#SELECTED_FILES[@]} -gt 0 && -f "${SELECTED_FILES[0]}" ]]; then
        echo "${SELECTED_FILES[0]}"
        return 0
    fi
    local found
    found=$(find . -maxdepth 2 -type f \( "${IMG_PATTERN[@]}" \) 2>/dev/null | head -n 1)
    if [[ -n "$found" && -f "$found" ]]; then
        echo "$found"
        return 0
    fi
    echo ""
}

prompt_setting_value() {
    local label="$1" current="$2" presets="$3" regex="$4"
    local out query selected choice ret

    out=$(printf "%s\n" $presets | fzf --prompt="$label ❯ " \
        --header="Current: $current | Select or type new value, then [ENTER] | [ESC]: Cancel" \
        --print-query)
    ret=$?

    # fzf >= 0.61: ENTER sin match contra los items sale con rc=1 pero imprime el query
    [[ $ret -ne 0 && $ret -ne 1 ]] && return 1
    [[ -z "$out" ]] && return 1

    query=$(head -n 1 <<< "$out")
    selected=$(tail -n 1 <<< "$out")

    choice="$selected"
    if [[ -n "$query" && "$query" != "$selected" ]]; then
        choice="$query"
    fi

    [[ -z "$choice" ]] && return 1

    if [[ -n "$regex" && ! "$choice" =~ $regex ]]; then
        echo -e "${C_RED}[!] Invalid value: '$choice'.${C_RESET}"
        sleep 1
        return 1
    fi

    echo "$choice"
}

interactive_tune_settings() {
    local sample_img="$1"
    local title_context="${2:-Wallpaper}"

    [[ -z "$sample_img" || ! -f "$sample_img" ]] && sample_img=$(get_sample_image)

    local cursor_pos=1

    while true; do
        build_adjust_spec

        export PREV_IMG="$sample_img"
        export PREV_SPEC="$ADJUST_SPEC"
        export PREV_NAME="${title_context}"
        export CONVERT_SCRIPT="$CONVERT_SCRIPT"

        local menu_lines=()
        menu_lines+=("󰄬  Continue with these settings ❯")
        menu_lines+=("󰏘  Palette name            : <  ${CUSTOM_NAME:-(nombre de archivo)}  >  (Enter to change)")
        menu_lines+=("󰅚  Saturation              : <  $SATURATION  >  (Enter to change)")
        menu_lines+=("󰃠  Contrast                : <  $CONTRAST  >  (Enter to change)")
        menu_lines+=("󰃟  Brightness              : <  $BRIGHTNESS  >  (Enter to change)")
        menu_lines+=("󰔏  Temperature             : <  $TEMPERATURE  >  (Enter to change)")
        menu_lines+=("󰖌  Tint                    : <  $TINT  >  (Enter to change)")
        menu_lines+=("󰁨  Vibrance                : <  $VIBRANCE  >  (Enter to change)")
        menu_lines+=("󰉼  Hue shift               : <  $HUE  >  (Enter to change)")
        menu_lines+=("󰗑  Normalize               : <  $NORMALIZE  >  (Enter to change)")
        menu_lines+=("󰘦  Extra adjust spec (raw) : <  ${EXTRA_SPEC:-(none)}  >  (Enter to change)")
        menu_lines+=("󰜉  Reset to defaults")

        local item ret
        item=$(printf '%s\n' "${menu_lines[@]}" \
            | fzf --prompt=" Adjust: ${title_context} ❯ " \
                  --header="[ENTER]: Change setting / Continue  |  [ESC]: Back" \
                  --bind="start:pos($cursor_pos)" \
                  --preview "'$LIVE_PREVIEW_SCRIPT'" \
                  --preview-window=right:55%:border-left)
        ret=$?

        [[ $ret -ne 0 && -z "$item" ]] && return 1
        [[ -z "$item" ]] && return 1

        case "$item" in
            *"Continue"*)          cursor_pos=1 ;;
            *"Palette name"*)      cursor_pos=2 ;;
            *"Saturation"*)        cursor_pos=3 ;;
            *"Contrast"*)          cursor_pos=4 ;;
            *"Brightness"*)        cursor_pos=5 ;;
            *"Temperature"*)       cursor_pos=6 ;;
            *"Tint"*)              cursor_pos=7 ;;
            *"Vibrance"*)          cursor_pos=8 ;;
            *"Hue shift"*)         cursor_pos=9 ;;
            *"Normalize"*)         cursor_pos=10 ;;
            *"Extra"*)             cursor_pos=11 ;;
            *"Reset"*)             cursor_pos=12 ;;
        esac

        case "$item" in
            *"Continue"*)
                save_config
                return 0
                ;;
            *"Palette name"*)
                local stem
                stem=$(basename "${sample_img%.*}" 2>/dev/null)
                local val
                val=$(prompt_palette_name "${CUSTOM_NAME:-$stem}")
                if [[ -n "$val" ]]; then
                    if [[ -f "$PALETTES_DIR/$val.json" ]]; then
                        local over
                        over=$(printf "󰄬  Sobrescribir '$val'\n󰗼  Elegir otro nombre" | fzf \
                            --prompt="󰏘  '$val.json' ya existe ❯ " \
                            --header="[ENTER]: elegir | [ESC]: elegir otro nombre")
                        if [[ -z "$over" || "$over" == *"otro nombre"* ]]; then
                            continue
                        fi
                    fi
                    CUSTOM_NAME="$val"
                    echo -e "${C_GREEN}[OK] Palette name → $CUSTOM_NAME${C_RESET}"
                    sleep 0.4
                fi
                continue
                ;;
            *"Saturation"*)
                local val
                val=$(prompt_setting_value "󰅚 Saturation (-100..100)" "$SATURATION" "0 10 15 20 25 30 -10 -15 -20 -30" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { SATURATION="$val"; echo -e "${C_GREEN}[OK] Saturation → $SATURATION${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Contrast"*)
                local val
                val=$(prompt_setting_value "󰃠 Contrast (-100..100)" "$CONTRAST" "0 5 10 15 20 25 30 -5 -10 -15 -20" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { CONTRAST="$val"; echo -e "${C_GREEN}[OK] Contrast → $CONTRAST${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Brightness"*)
                local val
                val=$(prompt_setting_value "󰃟 Brightness (-100..100)" "$BRIGHTNESS" "0 5 10 15 20 -5 -10 -15 -20" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { BRIGHTNESS="$val"; echo -e "${C_GREEN}[OK] Brightness → $BRIGHTNESS${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Temperature"*)
                local val
                val=$(prompt_setting_value "󰔏 Temperature (-100..100, + warm / - cool)" "$TEMPERATURE" "0 5 10 15 20 -5 -10 -15 -20" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { TEMPERATURE="$val"; echo -e "${C_GREEN}[OK] Temperature → $TEMPERATURE${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Tint"*)
                local val
                val=$(prompt_setting_value "󰖌 Tint (-100..100, + magenta / - green)" "$TINT" "0 5 10 15 -5 -10 -15" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { TINT="$val"; echo -e "${C_GREEN}[OK] Tint → $TINT${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Vibrance"*)
                local val
                val=$(prompt_setting_value "󰁨 Vibrance (-100..100, smart saturation)" "$VIBRANCE" "0 10 20 30 -10 -20 -30" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { VIBRANCE="$val"; echo -e "${C_GREEN}[OK] Vibrance → $VIBRANCE${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Hue shift"*)
                local val
                val=$(prompt_setting_value "󰉼 Hue shift (-100..100)" "$HUE" "0 5 10 15 -5 -10 -15 30 -30" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { HUE="$val"; echo -e "${C_GREEN}[OK] Hue shift → $HUE${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Normalize"*)
                local val
                val=$(prompt_setting_value "󰗑 Normalize (-100..100, unify lightness)" "$NORMALIZE" "0 10 20 30 50 -10 -20" "^-?[0-9]+$")
                [[ -n "$val" && "$val" -ge -100 && "$val" -le 100 ]] && { NORMALIZE="$val"; echo -e "${C_GREEN}[OK] Normalize → $NORMALIZE${C_RESET}"; sleep 0.4; }
                continue
                ;;
            *"Extra"*)
                local val out query
                out=$(printf "%s" "$EXTRA_SPEC" | fzf --prompt="󰘦  Extra spec (recol -a syntax, ej: pal.hue=180,sel.invert) ❯ " \
                    --header="Current: ${EXTRA_SPEC:-(none)} | Type spec + [ENTER] | [ESC]: Cancel" --print-query)
                ret=$?
                # rc 0 o 1: ENTER acepta el query (1 = sin match contra los items)
                [[ $ret -eq 0 || $ret -eq 1 ]] && {
                    query=$(head -n 1 <<< "$out")
                    query="${query//$'\n'/}"
                    EXTRA_SPEC="$query"
                    echo -e "${C_GREEN}[OK] Extra spec → ${EXTRA_SPEC:-(none)}${C_RESET}"
                    sleep 0.4
                }
                continue
                ;;
            *"Reset"*)
                reset_settings
                echo -e "${C_CYAN}[i] Settings reset to defaults.${C_RESET}"
                sleep 0.6
                continue
                ;;
        esac
    done
}

